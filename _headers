# _headers
#
# Cloudflare header rules (read by Workers static assets; same format as Pages). Most-specific path wins; a request that
# matches more than one block gets the union of their headers.
#
# The service worker and manifest must never be served stale — the SW file
# itself is how Trakka's offline shell learns a new version exists at all,
# so a cached copy of *it* would stall every future update. Everything else
# (HTML, JS, CSS, icons) is fine to cache normally; app.js/service-worker.js
# already self-version via CACHE_VERSION and the SW's network-first fetch
# handling, so this file doesn't need to fight that.

/service-worker.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Baseline security headers on every response. No Cross-Origin-Opener-Policy
# here on purpose — COOP: same-origin breaks Firebase's signInWithPopup by
# severing the popup's window.opener link back to this page, which is how
# Firebase Auth hands the signed-in result back. If a Content-Security-Policy
# is added later, ship it as Content-Security-Policy-Report-Only first and
# make sure it allows *.googleapis.com, *.gstatic.com, *.firebaseapp.com
# (Firebase Auth/Firestore) and the CDN ExcelJS/JSZip are loaded from in
# app.js, or sign-in and Excel import/export will silently break.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Resource-Policy: same-site
  # Report-Only on purpose (LEG-07): this logs violations in the browser console
  # without blocking anything, so Firebase sign-in, ExcelJS/JSZip (bundled in
  # app.js) and the Spotify embed can't silently break. Load every page, watch
  # the console for "[Report Only]" violations, tighten, then rename this header
  # to Content-Security-Policy to enforce. 'unsafe-inline' is needed today because
  # the pages use inline <script>/<style>; removing it means moving those to files.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: data:; connect-src 'self' https://*.googleapis.com https://*.firebaseapp.com https://www.gstatic.com https://open.er-api.com https://securetoken.google.com; frame-src https://open.spotify.com https://*.firebaseapp.com https://accounts.google.com https://apis.google.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
