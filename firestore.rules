rules_version = '2';

// Deploy this in the Firebase console under
// Firestore Database → Rules (project: tracka-app-f97e1), or via the CLI:
//   firebase deploy --only firestore:rules
//
// Every signed-in user's tracker data lives in exactly one document,
// users/{their own auth uid} (see firebase-init.js). These rules make sure
// a request can only read or write the document whose ID matches the
// requester's own uid — nobody can read or write anyone else's data, and a
// signed-out request can't touch any of it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // One admin account reviews manual bank-transfer receipts (Settings →
      // "Go Premium") and approves/rejects them — see
      // listPendingPremiumRequests()/approvePremiumRequest()/
      // rejectPremiumRequest() in firebase-init.js. Checking the token's
      // email claim (rather than a fixed uid) means this never needs to
      // change even if that account is ever recreated. Kept in sync by
      // hand with the ADMIN_EMAIL constant in firebase-init.js and worker.js
      // — there's no shared config between a security-rules file and app
      // code, so all three have to agree if this address ever changes.
      allow read, write: if request.auth != null && request.auth.token.email == "lolafalobi@gmail.com";
    }

    // Crash/error reports (see firebase-init.js's reportClientError() and
    // admin.html) — anyone signed in can file one about themselves, but
    // only the admin account can read, resolve, or delete any of them.
    // Deliberately no update rule for the reporting user: a report can't be
    // edited after the fact by the person it's about, only reviewed by the
    // admin, who also needs delete (admin.html lets them clear out old
    // resolved/dismissed reports).
    match /errorReports/{reportId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null && request.auth.token.email == "lolafalobi@gmail.com";
    }

    // Admin action audit log (see firebase-init.js's logAdminActionImpl()
    // and admin.html) — a record of every account fix the admin makes.
    // Admin-only, both ways: nobody else should even know this collection
    // exists, let alone read or write to it.
    match /adminActions/{actionId} {
      allow read, create: if request.auth != null && request.auth.token.email == "lolafalobi@gmail.com";
    }

    // Everything else is denied by default (no matching rule = no access).
  }
}
