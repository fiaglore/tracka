rules_version = '2';

// Deploy this in the Firebase console under
// Firestore Database → Rules (project: tracka-app-f97e1), or via the CLI:
//   firebase deploy --only firestore:rules
//
// Every signed-in user's tracker data lives in exactly one document,
// users/{their own auth uid} (see firebase-init.js). These rules make sure
// a request can only read or write the document whose ID matches the
// requester's own uid — nobody can read or write anyone else's data, and a
// signed-out request can't touch any of it.
service cloud.firestore {
  match /databases/{database}/documents {
    // Fields only the server (Cloud Function / Worker / Admin SDK) or the admin
    // account may write. Before this, any signed-in user could write
    // `entitlements` on their own doc and grant themselves Premium.
    //   entitlements  — current Premium entitlement (premium, premiumExpiresAt)
    //   billing       — planned Paystack entitlement (PAY-01); reserved now
    //   admin         — reserved for operator-only flags
    function touchesProtected(keys) {
      return keys.hasAny(['entitlements', 'billing', 'admin']);
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && !touchesProtected(request.resource.data.keys());
      allow update: if request.auth != null && request.auth.uid == userId
        && !touchesProtected(request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if request.auth != null && request.auth.uid == userId;

      // One admin account reviews manual bank-transfer receipts (Settings →
      // "Go Premium") and approves/rejects them — see
      // listPendingPremiumRequests()/approvePremiumRequest()/
      // rejectPremiumRequest() in firebase-init.js. Checking the token's
      // email claim (rather than a fixed uid) means this never needs to
      // change even if that account is ever recreated. Kept in sync by
      // hand with the ADMIN_EMAIL constant in firebase-init.js and worker.js
      // — there's no shared config between a security-rules file and app
      // code, so all three have to agree if this address ever changes.
      allow read, write: if request.auth != null && request.auth.token.email == "lolafalobi@gmail.com";
    }

    // Feature flags (PRD-00): new features ship dark behind a flag in
    // featureFlags/global. Any signed-in user may read; only the admin
    // account (or the Admin SDK, which bypasses rules) may change them.
    match /featureFlags/{flagDoc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "lolafalobi@gmail.com";
    }

    // Everything else is denied by default (no matching rule = no access).
  }
}
